#load "lexer.mew"
#load "parser.mew"

namespace parsing;

type Evaluator { }
impl Visitor for Evaluator {
    fn visit_integer(expr: IntegerExpression) -> i64 {
        return expr.value;
    }

    fn visit_arithmetic(expr: ArithmeticExpression) -> i64 {
        let left = expr.left.accept(self);
        let right = expr.right.accept(self);
        return match expr.operator {
               .Addition => left + right,
               .Subtraction => left - right,
               .Multiplication => left * right,
               .Division => left / right,
               .PowerOf => left.pow(right),
        };
    }
}

pub fn evaluate(text: string) -> Result<i64, string> {
    if text.is_empty() {
        return .ok(0);
    }

    let tokens = tokenize(text)?;
    let expr = parse(tokens)?;

    let eval = new Evaluator { };
    return .ok(expr.accept(eval));
}