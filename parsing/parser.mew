#load "lexer.mew"

namespace parsing;

pub union Operator {
    Addition,
    Subtraction,
    Multiplication,
    Division,
    PowerOf
}

pub interface Visitor {
    fn visit_integer(expr: IntegerExpression) -> i64;
    fn visit_arithmetic(expr: ArithmeticExpression) -> i64;
}

pub interface Expression {
    fn accept(visitor: Visitor) -> i64;
}

pub type IntegerExpression {
    pub field value: i64;
}

impl Expression for IntegerExpression {
    fn accept(visitor: Visitor) -> i64 {
        return visitor.visit_integer(self);
    }
}

pub type ArithmeticExpression {
    pub field operator: Operator;
    pub field left: Expression;
    pub field right: Expression;
}

impl Expression for ArithmeticExpression {
    fn accept(visitor: Visitor) -> i64 {
        return visitor.visit_arithmetic(self);
    }
}

pub type ErrorExpression { 
    pub field message: string;
}

impl Expression for ErrorExpression {
    fn accept(visitor: Visitor) -> i64 {
        std.panic(message);
    }
}

pub fn parse(tokens: Enumerable<Token>) -> Result<Expression, string> {
    let mut stack = Stack<Expression>::new();
    for token in tokens {
        match token {   
            .LParen => { /* Ignore */ },
            .RParen => { /* Ignore */ }
            .Integer(value) => stack.push(new IntegerExpression { value: value }),
            .Operator(op) => {
                let right = stack.pop().ok_or("Expected operand on stack")?;
                let left = stack.pop().ok_or("Expected operand on stack")?;
                stack.push(new ArithmeticExpression {
                    operator: op.kind,
                    left: left,
                    right: right,
                });
            },
        }
    }

    return .ok(stack.pop().ok_or("Expected expression on stack but found none")?);
}