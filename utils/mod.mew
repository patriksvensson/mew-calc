// Prelude
#load "list.mew"
#load "stack.mew"
#load "peek.mew"

impl char {
    pub fn is_number() -> bool {
        if self == '0' || self == '1' || self == '2'
        || self == '3' || self == '4' || self == '5'
        || self == '6' || self == '7' || self == '8'
        || self == '9' {
            return true;
        }

        return false;
    }
}

pub interface Display {
    pub fn Display() -> string;
}
