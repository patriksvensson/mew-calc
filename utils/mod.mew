// Prelude
#load "list.mew"
#load "stack.mew"
#load "peek.mew"

impl char {
    pub fn is_number() -> bool {
        if self == '0' || self == '1' || self == '2'
        || self == '3' || self == '4' || self == '5'
        || self == '6' || self == '7' || self == '8'
        || self == '9' {
            return true;
        }

        return false;
    }
}

impl i64 {
    pub fn pow(exponent: i64) -> i64 {
        let mut result = 1i64;
        let mut base = self;
        let mut left = exponent;
        while left > 0 {
            if left % 2 == 1 {
                result *= base;
            }

            base *= base;
            left /= 2;
        }

        return result;
    }
}

pub interface Display {
    pub fn Display() -> string;
}
